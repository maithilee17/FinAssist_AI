# Application
APP_ENV=development
LOG_LEVEL=INFO
API_V1_PREFIX=/api
BACKEND_PORT=8000
FRONTEND_PORT=5173
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173
# Browser API base. In production prefer a same-site HTTPS URL such as
# https://app.example.com/api or an HTTPS API origin allowed by CORS_ORIGINS.
VITE_API_URL=http://localhost:8000/api

# PostgreSQL
POSTGRES_DB=finassist
POSTGRES_USER=finassist
POSTGRES_PASSWORD=change-this-local-password
DATABASE_URL=postgresql+asyncpg://finassist:change-this-local-password@postgres:5432/finassist

# ChromaDB
CHROMA_HOST=chroma
CHROMA_PORT=8000
CHROMA_SSL=false
CHROMA_HOST_PORT=8001

# Authentication (used from Phase 2 onward)
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_ISSUER=finassist-ai
JWT_AUDIENCE=finassist-ai-web
ACCESS_TOKEN_EXPIRE_MINUTES=30
AUTH_COOKIE_NAME=finassist_access_token
CSRF_COOKIE_NAME=finassist_csrf_token
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
VITE_CSRF_COOKIE_NAME=finassist_csrf_token

# Production/staging startup requires COOKIE_SECURE=true, a strong JWT secret,
# and explicit HTTPS CORS origins (wildcards and HTTP origins are rejected).

# Tests default to an isolated in-memory SQLite database. To exercise PostgreSQL,
# use a dedicated database whose URL contains "test"; tests create and drop tables.
TEST_DATABASE_URL=sqlite+aiosqlite:///:memory:

# Document processing (used from Phase 3 onward)
MAX_UPLOAD_SIZE_MB=50
UPLOAD_READ_CHUNK_BYTES=1048576
UPLOAD_DIR=/app/uploads
CHUNK_SIZE_TOKENS=500
CHUNK_OVERLAP_TOKENS=100
VITE_MAX_UPLOAD_SIZE_MB=50
VITE_PROCESSING_TIMEOUT_MS=600000
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=32
EMBEDDING_EXPECTED_DIMENSION=384
# Immutable revision verified with the configured BGE model.
EMBEDDING_MODEL_REVISION=5c38ec7c405ec4b44b94cc5a9bb96e735b38267a
# Set true only after the complete model is present in HF_HOME.
EMBEDDING_LOCAL_FILES_ONLY=false
EMBEDDING_QUERY_PREFIX=Represent this sentence for searching relevant passages: 
CHROMA_COLLECTION=financial_document_chunks
RAG_TOP_K=5
RAG_MIN_SIMILARITY=0.25
RAG_SOURCE_EXCERPT_CHARS=600
BM25_K1=1.5
BM25_B=0.75
BM25_EPSILON=0.25
BM25_CACHE_USERS=128
RRF_CONSTANT=60
ADAPTIVE_EXACT_TERM_THRESHOLD=1
EVIDENCE_RELEVANCE_THRESHOLD=0.45
EVIDENCE_SUFFICIENCY_THRESHOLD=0.70
EVIDENCE_WEAK_THRESHOLD=0.25
EVIDENCE_MAX_TOP_K=15
EVIDENCE_MAX_RETRIEVAL_ATTEMPTS=2
ANSWER_MAX_REVISION_ATTEMPTS=1
CLAIM_SUPPORT_THRESHOLD=0.35

# Local generation only; no external LLM credentials required.
LLM_PROVIDER=ollama
LLM_TIMEOUT_SECONDS=120
LLM_MAX_OUTPUT_TOKENS=800
# Native backend URL; Compose uses the separate Docker host gateway.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_DOCKER_BASE_URL=http://host.docker.internal:11434
# Primary candidate for the audited 8 GB VRAM laptop.
# Optional manual fallback: qwen2.5:3b (download only after approval).
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_CONNECT_TIMEOUT_SECONDS=5
OLLAMA_NUM_CTX=8192
